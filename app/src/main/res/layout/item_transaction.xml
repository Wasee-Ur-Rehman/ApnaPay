<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:background="?android:attr/selectableItemBackground"> <!-- Adds ripple effect on click -->

    <!-- Icon / Initials Box -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/iconContainer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="#F3F4F6"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Initials (e.g., LP, JF) -->
        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="LP"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Optional: You can hide tvInitials and show this ImageView for actual icons -->
        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:tint="@color/apnapay_purple"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Transaction Title -->
    <TextView
        android:id="@+id/tvTransactionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Transfer To Ahmad F"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/iconContainer"
        app:layout_constraintStart_toEndOf="@id/iconContainer"
        app:layout_constraintEnd_toStartOf="@id/tvTransactionAmount"/>

    <!-- Date & Time -->
    <TextView
        android:id="@+id/tvTransactionDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="6 Sep, 2024  •  17:02"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvTransactionTitle"
        app:layout_constraintStart_toStartOf="@id/tvTransactionTitle"
        app:layout_constraintEnd_toStartOf="@id/tvTransactionAmount"/>

    <!-- Amount -->
    <TextView
        android:id="@+id/tvTransactionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-$163.98"
        android:textColor="@color/error_red"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>