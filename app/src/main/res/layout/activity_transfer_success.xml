<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:padding="24dp">

    <!-- Top Bar -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/back"
        app:tint="@color/text_main"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transfer Success"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_main"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/imgSuccessCheck"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/yes"
        app:tint="@color/apnapay_purple"
        android:padding="20dp"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Receipt Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/receiptCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-40dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/imgSuccessCheck">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="64dp"
            android:paddingBottom="32dp"
            android:paddingHorizontal="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total"
                android:textColor="@color/text_main"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 903.00"
                android:textColor="@color/text_main"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <!-- Dashed line placeholder (using a solid line for simplicity in XML) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"/>

            <!-- Details -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total transfer" android:textColor="@color/text_muted"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 900.00" android:textColor="@color/text_main" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Admin fee" android:textColor="@color/text_muted"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 3.00" android:textColor="@color/text_main" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total" android:textColor="@color/text_main" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 903.00" android:textColor="@color/success_green" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Info Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/bg_light"
                android:padding="16dp"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/great"
                    android:backgroundTint="@color/apnapay_purple_dark"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thank you for using ApnaPay."
                    android:backgroundTint="@color/success_green"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- The Cutout UI Hack (Left and Right circles) -->
    <View
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_circle_translucent"
        android:backgroundTint="@color/bg_light"
        android:translationX="-15dp"
        app:layout_constraintTop_toTopOf="@id/receiptCard"
        app:layout_constraintBottom_toBottomOf="@id/receiptCard"
        app:layout_constraintStart_toStartOf="@id/receiptCard"/>

    <View
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_circle_translucent"
        android:backgroundTint="@color/bg_light"
        android:translationX="15dp"
        app:layout_constraintTop_toTopOf="@id/receiptCard"
        app:layout_constraintBottom_toBottomOf="@id/receiptCard"
        app:layout_constraintEnd_toEndOf="@id/receiptCard"/>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="Share"
            android:textColor="@color/text_main"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="@color/white"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="Done"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="@color/apnapay_purple"
            app:cornerRadius="12dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>