<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:padding="24dp">

    <!-- Header -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/back"
        app:tint="@color/text_main"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign Up"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_main"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Email -->
    <TextView
        android:id="@+id/lblEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textColor="@color/text_main"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="Text your email"
        android:paddingHorizontal="16dp"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/lblEmail"/>

    <!-- Password -->
    <TextView
        android:id="@+id/lblPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textColor="@color/text_main"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etEmail"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="Text your password"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword"
        app:layout_constraintTop_toBottomOf="@id/lblPassword"/>

    <!-- Confirm Password -->
    <TextView
        android:id="@+id/lblConfirmPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm password"
        android:textColor="@color/text_main"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etPassword"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="Text your password"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword"
        app:layout_constraintTop_toBottomOf="@id/lblConfirmPassword"/>

    <!-- Submit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitSignUp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Sign Up"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/apnapay_purple"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/etConfirmPassword" />

    <!-- "Or" Divider -->
    <LinearLayout
        android:id="@+id/dividerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/btnSubmitSignUp"
        android:layout_marginTop="24dp">

        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" android:background="#E5E7EB"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Or" android:textColor="@color/text_muted" android:layout_marginHorizontal="16dp"/>
        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" android:background="#E5E7EB"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGoogle"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_social_button"
        android:text="@string/continue_with_google"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:drawableStart="@drawable/google"
        android:paddingStart="24dp"
        android:paddingEnd="48dp"
        android:layout_marginTop="24dp"
        android:elevation="0dp"
        app:elevation="0dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/dividerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnFacebook"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_social_button"
        android:text="@string/continue_with_facebook"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:drawableStart="@drawable/facebook"
        android:elevation="0dp"
        app:elevation="0dp"
        android:stateListAnimator="@null"
        android:paddingStart="24dp"
        android:paddingEnd="48dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnGoogle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Footer link: Already have an account? Log In -->
    <LinearLayout
        android:id="@+id/footerLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="38dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/hasAccText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? "
            android:textSize="12sp"
            android:textColor="@color/text_muted"/>

        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log In"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/apnapay_purple"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>